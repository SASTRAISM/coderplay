# ── DGX Deployment Environment ────────────────────────────────────────────────
# Copy this file to .env.production.local on the DGX before running npm run build
# All students open coderplay.kauverylabs.ai — backend is at the public URL below

# Backend public URL (DGX backend tunnel)
NEXT_PUBLIC_AI_BACKEND_URL=https://coderplay-backend.kauverylabs.ai

# Frontend runs on port 5175 (served as static export, tunneled via coderplay-tunnel)
# Backend runs on port 5002 (tunneled via coderplay-dgx-backend tunnel)
