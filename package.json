{
  "name": "coderplay-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 5175 -H 0.0.0.0",
    "build": "next build",
    "build:dgx": "node scripts/fix-encoding.js && cross-env NEXT_PUBLIC_AI_BACKEND_URL='https://coderplay-api.kauverylabs.ai' next build",
    "build:mac": "next build",
    "build:local": "node scripts/fix-encoding.js && cross-env NEXT_PUBLIC_AI_BACKEND_URL='http://localhost:5002' next build",
    "start": "node scripts/serve-dist.js",
    "frontend:ensure": "node scripts/run-or-reuse.js frontend",
    "frontend:ensure:dev": "node scripts/run-or-reuse.js frontend dev",
    "lint": "next lint",
    "backend": "npm --prefix backend run dev",
    "backend:start": "npm --prefix backend run start",
    "backend:ensure": "node scripts/run-or-reuse.js backend",
    "ollama": "OLLAMA_HOST=0.0.0.0:11435 ollama serve || true",
    "ollama:ensure": "node scripts/run-or-reuse.js ollama",
    "cloudflare": "node scripts/cloudflare-tunnel.js",
    "cloudflare:dgx": "TUNNEL_MODE=dgx node scripts/cloudflare-tunnel.js",
    "cloudflare:mac": "TUNNEL_MODE=mac node scripts/cloudflare-tunnel.js",
    "health:dgx": "node scripts/dgx-healthcheck.js",
    "watch:all": "concurrently --kill-others-on-fail false -n frontend,backend,ollama -c cyan,yellow,green \"npm run dev\" \"npm run backend\" \"npm run ollama\"",
    "dev:all": "npm run build:local && concurrently --kill-others-on-fail false -n frontend,backend,ollama -c cyan,yellow,green \"npm run frontend:ensure:dev\" \"npm run backend:ensure\" \"npm run ollama:ensure\"",
    "tunnels": "cloudflared tunnel run --token $(cat ~/.cloudflared/coderplay-token.txt) --url http://127.0.0.1:5175",
    "cloudflare:frontend": "node scripts/cloudflare-frontend.js",
    "dev:mac": "npm run build:mac && concurrently --kill-others-on-fail false -n backend,cloudflare -c yellow,blue \"npm run backend:ensure\" \"npm run cloudflare:mac\"",
    "postinstall": "npm --prefix backend install"
  },
  "dependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@google/generative-ai": "^0.24.1",
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@uiw/react-codemirror": "^4.25.10",
    "autoprefixer": "^10.4.19",
    "clsx": "^2.1.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "firebase": "^10.12.2",
    "framer-motion": "^11.3.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.395.0",
    "next": "14.2.5",
    "postcss": "^8.4.39",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.8.1",
    "tailwind-merge": "^2.3.0",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "victory-vendor": "^37.3.6"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "firebase-admin": "^13.10.0",
    "pdf-to-img": "^6.2.0",
    "sharp": "^0.35.3"
  }
}
