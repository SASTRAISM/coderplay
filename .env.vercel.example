# ── Vercel Environment Variables ─────────────────────────────────────────────
# Copy these into your Vercel project dashboard → Settings → Environment Variables
# (mark each as Production / Preview / Development as needed)

# ── Frontend (NEXT_PUBLIC_* are baked in at build time) ──────────────────────

# Leave EMPTY so the frontend calls /api/... on the same Vercel domain (same-origin)
NEXT_PUBLIC_AI_BACKEND_URL=

# Your Firebase web app config (from Firebase Console → Project Settings → Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Backend (serverless function — backend/server.js) ─────────────────────────

# Gemini API key (Google AI Studio → Get API Key)
GEMINI_API_KEY=

# Admin panel passcode (keep this secret)
ADMIN_CODE=

# Optional: Ollama is not reachable from Vercel (it runs on DGX).
# Leave unset; Gemini will be the only AI provider on Vercel.
# OLLAMA_BASE_URL=
# OLLAMA_MODEL=

# Optional: extra comma-separated CORS origins beyond the built-in allow-list
# EXTRA_CORS_ORIGINS=https://your-custom-domain.com

# Set automatically by Vercel — do not set manually
# NODE_ENV=production
# VERCEL=1
